# ---------------------------------------------------------------------------
# ReviewGen environment variables
# Copy this file to `.env.local` and fill in real values.
# Vite only exposes variables prefixed with VITE_ to the browser.
# ---------------------------------------------------------------------------

# Supabase project URL (Project Settings -> API -> Project URL).
# Leave both Supabase values empty to run against the local demo adapter.
VITE_SUPABASE_URL=

# Supabase anon/public key. This key is safe to ship to browsers; RLS enforces
# authorization. NEVER put the service_role key in a VITE_ variable.
VITE_SUPABASE_ANON_KEY=

# Canonical public origin used for generated customer review links / QR codes.
# Example: https://reviews.example.com
# Defaults to the browser origin when omitted.
VITE_PUBLIC_BASE_URL=

# Local demo adapter credentials only (ignored when Supabase is configured).
# Change these so local development does not use the published defaults.
VITE_DEMO_ADMIN_EMAIL=admin@reviewgen.local
VITE_DEMO_ADMIN_PASSWORD=reviewgen-demo
